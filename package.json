{
  "name": "@oi-yao/dsh-inline-visuals",
  "version": "1.0.0",
  "description": "Inline, replayable visuals for DeepSeek Harness: 14 chart, table, timeline, gantt, heatmap, flow and KPI kinds with presentation styles, click-to-ask interaction and agent-driven edit_visual patches.",
  "type": "module",
  "license": "MIT",
  "author": "YLifeOnlyOnce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YLifeOnlyOnce/dsh-inline-visuals.git"
  },
  "homepage": "https://github.com/YLifeOnlyOnce/dsh-inline-visuals#readme",
  "bugs": {
    "url": "https://github.com/YLifeOnlyOnce/dsh-inline-visuals/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "charts",
    "visualization",
    "tool-view"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:check": "npm pack --dry-run",
    "prepare-demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
