{
  "name": "@community/dsh-inline-visuals",
  "version": "0.2.0",
  "private": true,
  "description": "Inline, replayable visuals for DeepSeek Harness: charts, comparison tables, timelines, gantt and KPI tiles.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "prepare-demo": "node scripts/demo.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
